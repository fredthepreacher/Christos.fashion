[32m+[m[32m          </article>[m
[32m+[m
[32m+[m[32m          <article class="story-card reveal">[m
[32m+[m[32m            <div class="story-card-art">[m
[32m+[m[32m              <img src="assets/designs/work-hard-god-first.png" alt="Work Hard God First design artwork" loading="lazy" decoding="async" width="600" height="600" />[m
[32m+[m[32m            </div>[m
[32m+[m[32m            <div>[m
[32m+[m[32m              <h3>Work Hard, God First</h3>[m
[32m+[m[32m              <p class="story-card-message">"Ambition is fine. Order matters."</p>[m
[32m+[m[32m              <dl>[m
[32m+[m[32m                <dt>Why it matters</dt>[m
[32m+[m[32m                <dd>It doesn't ask you to want less. It asks you to keep the sequence right — which is the harder discipline of the two.</dd>[m
[32m+[m[32m                <dt>Who it's for</dt>[m
[32m+[m[32m                <dd>Founders, hustlers, and anyone whose calendar has started quietly outranking their prayer life.</dd>[m
[32m+[m[32m              </dl>[m
