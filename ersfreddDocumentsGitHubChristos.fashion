[32m+[m
[32m+[m[32m          <div class="prayer-copy reveal-left">[m
[32m+[m[32m            <p class="eyebrow">The Prayer Wall</p>[m
[32m+[m[32m            <h2 id="prayer-heading">Tell Us What<br><span class="title-italic">You're Carrying.</span></h2>[m
[32m+[m[32m            <p>[m
[32m+[m[32m              We're a clothing brand, but we're believers first. If something heavy is sitting on[m
[32m+[m[32m              you right now, send it here. Our team prays over every request that comes in.[m
[32m+[m[32m              You don't have to buy anything, and nothing you write is ever posted publicly.[m
[32m+[m[32m            </p>[m
[32m+[m
[32m+[m[32m            <div class="prayer-promise">[m
[32m+[m[32m              <p>"Cast all your anxiety on him because he cares for you."</p>[m
[32m+[m[32m              <cite>1 Peter 5:7</cite>[m
[32m+[m[32m            </div>[m
           </div>[m
[32m+[m
[32m+[m[32m          <form class="prayer-form reveal-right"[m
[32m+[m[32m                name="prayer-request"[m
[32m+[m[32m                method="POST"[m
[32m+[m[32m                data-netlify="true"[m
[32m+[m[32m                netlify-honeypot="bot-field"[m
[32m+[m[32m                aria-labelledby="prayer-heading">[m
