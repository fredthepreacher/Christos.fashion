[32m+[m[32m});[m
[32m+[m
[32m+[m[32m// ============================================================[m
[32m+[m[32m// GENTLE PARALLAX[m
[32m+[m[32m// Range is deliberately small (max ±--parallax-range, default[m
[32m+[m[32m// 40px) so the page still feels calm and nothing reflows.[m
[32m+[m[32m// ============================================================[m
[32m+[m[32m(function initParallax() {[m
[32m+[m[32m  const layers = Array.from(document.querySelectorAll('.parallax'));[m
[32m+[m[32m  if (!layers.length || prefersReducedMotion) return;[m
[32m+[m
[32m+[m[32m  let ticking = false;[m
[32m+[m
[32m+[m[32m  function update() {[m
[32m+[m[32m    const vh = window.innerHeight;[m
[32m+[m[32m    layers.forEach(layer => {[m
[32m+[m[32m      const rect = layer.getBoundingClientRect();[m
[32m+[m[32m      if (rect.bottom < -200 || rect.top > vh + 200) return;[m
[32m+[m[32m      const range = parseFloat(layer.dataset.parallaxRange || '40');[m
[32m+[m[32m      // -1 (below fold) → 1 (above fold)[m
[32m+[m[32m      const progress = (vh / 2 - (rect.top + rect.height / 2)) / (vh / 2 + rect.height / 2);[m
[32m+[m[32m      layer.style.setProperty('--parallax-y', (progress * range).toFixed(2) + 'px');[m
[32m+[m[32m    });[m
[32m+[m[32m    ticking = false;[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  function onScroll() {[m
[32m+[m[32m    if (!ticking) {[m
[32m+[m[32m      ticking = true;[m
[32m+[m[32m      requestAnimationFrame(update);[m
[32m+[m[32m    }[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  window.addEventListener('scroll', onScroll, { passive: true });[m
[32m+[m[32m  window.addEventListener('resize', onScroll, { passive: true });[m
[32m+[m[32m  update();[m
[32m+[m[32m})();[m
[32m+[m
