[32m+[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m   ============================================================[m
[32m+[m[32m   2.0 LAYER — LUXURY BRAND TRANSFORMATION[m
[32m+[m[32m   Everything below is additive. It never renames a v4 class,[m
[32m+[m[32m   so home-loader.js / shop-loader.js / variant-picker.js keep[m
[32m+[m[32m   rendering into the same hooks they always have.[m
[32m+[m[32m   ============================================================[m
[32m+[m[32m   ============================================================ */[m
[32m+[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m   SURFACE MODES[m
[32m+[m[32m   ------------------------------------------------------------[m
[32m+[m[32m   `.surface-ivory` re-points the shared tokens inside its own[m
[32m+[m[32m   subtree. Every existing component (eyebrow, value-card,[m
[32m+[m[32m   btn-outline, blockquote…) inverts correctly with no new[m
[32m+[m[32m   class names, which is what keeps the light "acts" cheap.[m
[32m+[m[32m   ============================================================ */[m
[32m+[m[32m.surface-ivory {[m
[32m+[m[32m  --bg:          var(--ivory);[m
[32m+[m[32m  --surface-1:   #FFFFFF;[m
[32m+[m[32m  --surface-2:   #F1EDE6;[m
[32m+[m[32m  --surface-3:   #E8E2D8;[m
[32m+[m[32m  --border:      var(--ink-border);[m
[32m+[m[32m  --border-gold: rgba(166,124,82,0.28);[m
[32m+[m
[32m+[m[32m  --cream:       var(--ink);[m
[32m+[m[32m  --cream-60:    var(--ink-70);[m
[32m+[m[32m  --cream-35:    var(--ink-45);[m
[32m+[m[32m  --cream-18:    var(--ink-border);[m
[32m+[m
[32m+[m[32m  --gold:        var(--gold-deep);[m
[32m+[m[32m  --gold-mid:    var(--bronze-deep);[m
[32m+[m[32m  --gold-light:  var(--bronze-deep);[m
[32m+[m[32m  --gold-glow:   rgba(166,124,82,0.14);[m
[32m+[m
[32m+[m[32m  --shadow-md:   var(--shadow-ivory);[m
[32m+[m[32m  --shadow-lg:   0 36px 70px -30px rgba(90,60,25,.28);[m
[32m+[m
[32m+[m[32m  background: var(--grad-ivory);[m
[32m+[m[32m  color: var(--ink);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m.surface-ivory .title-italic { color: var(--bronze-deep); }[m
[32m+[m[32m.surface-ivory blockquote,[m
[32m+[m[32m.surface-ivory .scripture { color: var(--ink-70); }[m
[32m+[m[32m.surface-ivory .btn-primary {[m
[32m+[m[32m  background: var(--ink);[m
[32m+[m[32m  color: var(--ivory);[m
[32m+[m[32m  border-color: var(--ink);[m
[32m+[m[32m}[m
[32m+[m[32m.surface-ivory .btn-primary:hover {[m
[32m+[m[32m  background: var(--burgundy);[m
[32m+[m[32m  border-color: var(--burgundy);[m
[32m+[m[32m  color: var(--ivory);[m
[32m+[m[32m}[m
[32m+[m[32m.surface-ivory .btn-outline { border-color: rgba(23,20,18,.28); color: var(--ink); }[m
[32m+[m[32m.surface-ivory .btn-outline:hover { border-color: var(--ink); background: rgba(23,20,18,.05); }[m
[32m+[m
[32m+[m[32m.surface-charcoal {[m
[32m+[m[32m  background: var(--grad-charcoal);[m
[32m+[m[32m  color: var(--cream);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* Hairline seam between acts — reads as a bound page edge */[m
[32m+[m[32m.surface-ivory + .surface-charcoal,[m
[32m+[m[32m.surface-charcoal + .surface-ivory { position: relative; }[m
[32m+[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m   MOTION PRIMITIVES[m
[32m+[m[32m   ------------------------------------------------------------[m
[32m+[m[32m   .reveal (v4) still drives fade-up. These add direction,[m
[32m+[m[32m   stagger, and a restrained parallax. All are disabled by the[m
[32m+[m[32m   prefers-reduced-motion block further down.[m
[32m+[m[32m   ============================================================ */[m
[32m+[m[32m.reveal { transition: opacity .9s var(--ease-editorial), transform .9s var(--ease-editorial); }[m
[32m+[m
[32m+[m[32m.reveal-left  { opacity: 0; transform: translateX(-28px); transition: opacity .9s var(--ease-editorial), transform .9s var(--ease-editorial); }[m
[32m+[m[32m.reveal-right { opacity: 0; transform: translateX(28px);  transition: opacity .9s var(--ease-editorial), transform .9s var(--ease-editorial); }[m
[32m+[m[32m.reveal-left.visible, .reveal-right.visible { opacity: 1; transform: none; }[m
[32m+[m
[32m+[m[32m.reveal-scale { opacity: 0; transform: scale(.965); transition: opacity 1s var(--ease-editorial), transform 1s var(--ease-editorial); }[m
[32m+[m[32m.reveal-scale.visible { opacity: 1; transform: none; }[m
[32m+[m
[32m+[m[32m/* Children fade up in sequence without per-element inline delays */[m
[32m+[m[32m.stagger > * { opacity: 0; transform: translateY(20px); transition: opacity .8s var(--ease-editorial), transform .8s var(--ease-editorial); }[m
[32m+[m[32m.stagger.visible > *          { opacity: 1; transform: none; }[m
[32m+[m[32m.stagger.visible > *:nth-child(1) { transition-delay: .00s; }[m
[32m+[m[32m.stagger.visible > *:nth-child(2) { transition-delay: .09s; }[m
[32m+[m[32m.stagger.visible > *:nth-child(3) { transition-delay: .18s; }[m
[32m+[m[32m.stagger.visible > *:nth-child(4) { transition-delay: .27s; }[m
[32m+[m[32m.stagger.visible > *:nth-child(5) { transition-delay: .36s; }[m
[32m+[m[32m.stagger.visible > *:nth-child(6) { transition-delay: .45s; }[m
[32m+[m
[32m+[m[32m/* Gentle parallax — translated by script.js, capped so it never[m
[32m+[m[32m   fights the scroll or shifts layout. */[m
[32m+[m[32m.parallax { will-change: transform; transform: translate3d(0, var(--parallax-y, 0), 0); }[m
[32m+[m
[32m+[m[32m/* Premium hover lift, shared by cards */[m
[32m+[m[32m.lift { transition: transform .5s var(--ease-editorial), box-shadow .5s var(--ease-editorial); }[m
[32m+[m[32m.lift:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); }[m
[32m+[m
[32m+[m[32m/* Word-by-word headline rise */[m
[32m+[m[32m.rise-words .word { display: inline-block; overflow: hidden; vertical-align: bottom; }[m
[32m+[m[32m.rise-words .word > span {[m
[32m+[m[32m  display: inline-block;[m
[32m+[m[32m  transform: translateY(105%);[m
[32m+[m[32m  transition: transform 1s var(--ease-editorial);[m
[32m+[m[32m}[m
[32m+[m[32m.rise-words.visible .word > span { transform: none; }[m
[32m+[m[32m.rise-words.visible .word:nth-child(2) > span { transition-delay: .07s; }[m
[32m+[m[32m.rise-words.visible .word:nth-child(3) > span { transition-delay: .14s; }[m
[32m+[m[32m.rise-words.visible .word:nth-child(4) > span { transition-delay: .21s; }[m
[32m+[m[32m.rise-words.visible .word:nth-child(5) > span { transition-delay: .28s; }[m
[32m+[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m   PHOTO SLOTS[m
[32m+[m[32m   ------------------------------------------------------------[m
[32m+[m[32m   Drop a real file at the documented path and it appears.[m
[32m+[m[32m   Until then the slot renders as a designed plate — never a[m
[32m+[m[32m   broken image — and carries its own shot spec for the shoot.[m
[32m+[m[32m   ============================================================ */[m
[32m+[m[32m.photo-slot {[m
[32m+[m[32m  position: relative;[m
[32m+[m[32m  margin: 0;[m
[32m+[m[32m  overflow: hidden;[m
[32m+[m[32m  border-radius: var(--radius-lg);[m
[32m+[m[32m  background:[m
[32m+[m[32m    radial-gradient(120% 90% at 50% 0%, rgba(212,175,55,.09), transparent 62%),[m
[32m+[m[32m    linear-gradient(160deg, var(--surface-2) 0%, var(--surface-1) 58%, var(--bg) 100%);[m
[32m+[m[32m  border: 1px solid var(--border);[m
[32m+[m[32m  isolation: isolate;[m
[32m+[m[32m}[m
[32m+[m[32m.surface-ivory .photo-slot {[m
[32m+[m[32m  background:[m
[32m+[m[32m    radial-gradient(120% 90% at 50% 0%, rgba(166,124,82,.12), transparent 62%),[m
[32m+[m[32m    linear-gradient(160deg, #EFEAE1 0%, #F5F1EA 58%, #FFFFFF 100%);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m.photo-slot-portrait  { aspect-ratio: 4 / 5; }[m
[32m+[m[32m.photo-slot-square    { aspect-ratio: 1 / 1; }[m
[32m+[m[32m.photo-slot-landscape { aspect-ratio: 3 / 2; }[m
[32m+[m[32m.photo-slot-wide      { aspect-ratio: 16 / 9; }[m
[32m+[m[32m.photo-slot-tall      { aspect-ratio: 2 / 3; }[m
[32m+[m
[32m+[m[32m.photo-slot img {[m
[32m+[m[32m  position: absolute;[m
[32m+[m[32m  inset: 0;[m
[32m+[m[32m  width: 100%;[m
[32m+[m[32m  height: 100%;[m
[32m+[m[32m  object-fit: cover;[m
[32m+[m[32m  z-index: 2;[m
[32m+[m[32m  transition: transform 1.2s var(--ease-editorial), filter 1.2s var(--ease-editorial);[m
[32m+[m[32m}[m
[32m+[m[32m.photo-slot:hover img { transform: scale(1.035); }[m
[32m+[m
[32m+[m[32m/* Watermark monogram — the empty state's quiet centrepiece */[m
[32m+[m[32m.photo-slot-mark {[m
[32m+[m[32m  position: absolute;[m
[32m+[m[32m  inset: 0;[m
[32m+[m[32m  display: flex;[m
[32m+[m[32m  flex-direction: column;[m
[32m+[m[32m  align-items: center;[m
[32m+[m[32m  justify-content: center;[m
[32m+[m[32m  gap: 14px;[m
[32m+[m[32m  z-index: 1;[m
[32m+[m[32m  padding: 24px;[m
[32m+[m[32m  text-align: center;[m
[32m+[m[32m}[m
[32m+[m[32m.photo-slot-mark svg {[m
[32m+[m[32m  width: 34px;[m
[32m+[m[32m  height: 46px;[m
[32m+[m[32m  color: var(--gold);[m
[32m+[m[32m  opacity: .34;[m
[32m+[m[32m}[m
[32m+[m[32m.photo-slot-mark .photo-slot-label {[m
[32m+[m[32m  font-family: var(--font-body);[m
[32m+[m[32m  font-size: 10px;[m
[32m+[m[32m  font-weight: 600;[m
[32m+[m[32m  letter-spacing: .2em;[m
[32m+[m[32m  text-transform: uppercase;[m
[32m+[m[32m  color: var(--cream-35);[m
[32m+[m[32m}[m
[32m+[m[32m.photo-slot-mark .photo-slot-hint {[m
[32m+[m[32m  font-family: var(--font-accent);[m
[32m+[m[32m  font-style: italic;[m
[32m+[m[32m  font-size: .95rem;[m
[32m+[m[32m  line-height: 1.5;[m
[32m+[m[32m  max-width: 30ch;[m
[32m+[m[32m  color: var(--cream-35);[m
[32m+[m[32m}[m
[32m+[m[32m.photo-slot-mark .photo-slot-path {[m
[32m+[m[32m  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;[m
[32m+[m[32m  font-size: 10px;[m
[32m+[m[32m  letter-spacing: .02em;[m
[32m+[m[32m  color: var(--cream-18);[m
[32m+[m[32m  word-break: break-all;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* Once a real photo loads it covers the mark; if the file is[m
[32m+[m[32m   missing the onerror handler hides the img and the mark stays. */[m
[32m+[m[32m.photo-slot.is-empty img { display: none; }[m
[32m+[m
[32m+[m[32m/* Editorial framing devices */[m
[32m+[m[32m.photo-frame-gold { position: relative; }[m
[32m+[m[32m.photo-frame-gold::after {[m
[32m+[m[32m  content: '';[m
[32m+[m[32m  position: absolute;[m
[32m+[m[32m  inset: 12px;[m
[32m+[m[32m  border: 1px solid rgba(212,175,55,.28);[m
[32m+[m[32m  border-radius: calc(var(--radius-lg) - 6px);[m
[32m+[m[32m  pointer-events: none;[m
[32m+[m[32m  z-index: 3;[m
[32m+[m[32m}[m
[32m+[m[32m.photo-caption {[m
[32m+[m[32m  margin-top: 12px;[m
[32m+[m[32m  font-family: var(--font-body);[m
[32m+[m[32m  font-size: 11px;[m
[32m+[m[32m  letter-spacing: .14em;[m
[32m+[m[32m  text-transform: uppercase;[m
[32m+[m[32m  color: var(--cream-35);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m   STORY HERO[m
[32m+[m[32m   ============================================================ */[m
[32m+[m[32m.hero-story {[m
[32m+[m[32m  position: relative;[m
[32m+[m[32m  min-height: 100svh;[m
[32m+[m[32m  display: flex;[m
[32m+[m[32m  align-items: center;[m
[32m+[m[32m  padding-top: calc(var(--nav-h) + 40px);[m
[32m+[m[32m  padding-bottom: 72px;[m
[32m+[m[32m  overflow: hidden;[m
[32m+[m[32m  background: var(--grad-charcoal);[m
[32m+[m[32m}[m
[32m+[m[32m.hero-story::before {[m
[32m+[m[32m  content: '';[m
[32m+[m[32m  position: absolute;[m
[32m+[m[32m  inset: 0;[m
[32m+[m[32m  background:[m
[32m+[m[32m    radial-gradient(78% 58% at 22% 34%, rgba(212,175,55,.13), transparent 64%),[m
[32m+[m[32m    radial-gradient(62% 52% at 86% 78%, rgba(90,30,30,.30), transparent 68%);[m
[32m+[m[32m  pointer-events: none;[m
[32m+[m[32m}[m
[32m+[m[32m.hero-story-inner {[m
[32m+[m[32m  position: relative;[m
[32m+[m[32m  z-index: 2;[m
[32m+[m[32m  display: grid;[m
[32m+[m[32m  grid-template-columns: 1.05fr .95fr;[m
[32m+[m[32m  align-items: center;[m
[32m+[m[32m  gap: clamp(40px, 6vw, 88px);[m
[32m+[m[32m}[m
[32m+[m[32m.hero-story-copy { max-width: 620px; }[m
[32m+[m[32m.hero-story-copy h1 {[m
[32m+[m[32m  margin-top: 22px;[m
[32m+[m[32m  font-size: clamp(3rem, 7vw, 5.6rem);[m
[32m+[m[32m}[m
[32m+[m[32m.hero-story-copy h1 .italic {[m
[32m+[m[32m  display: block;[m
[32m+[m[32m  font-style: italic;[m
[32m+[m[32m  font-weight: 400;[m
[32m+[m[32m  background: var(--grad-gold);[m
[32m+[m[32m  -webkit-background-clip: text;[m
[32m+[m[32m  background-clip: text;[m
[32m+[m[32m  color: transparent;[m
[32m+[m[32m}[m
[32m+[m[32m.hero-story-lede {[m
[32m+[m[32m  margin-top: 26px;[m
[32m+[m[32m  font-size: clamp(1.02rem, 1.5vw, 1.2rem);[m
[32m+[m[32m  line-height: 1.85;[m
[32m+[m[32m  color: var(--cream-60);[m
[32m+[m[32m  max-width: 52ch;[m
[32m+[m[32m}[m
[32m+[m[32m.hero-story-actions {[m
[32m+[m[32m  display: flex;[m
[32m+[m[32m  flex-wrap: wrap;[m
[32m+[m[32m  gap: 14px;[m
[32m+[m[32m  margin-top: 36px;[m
[32m+[m[32m}[m
[32m+[m[32m.hero-story-proof {[m
[32m+[m[32m  display: flex;[m
[32m+[m[32m  flex-wrap: wrap;[m
[32m+[m[32m  align-items: center;[m
[32m+[m[32m  gap: 12px 26px;[m
[32m+[m[32m  margin-top: 40px;[m
[32m+[m[32m  padding-top: 26px;[m
[32m+[m[32m  border-top: 1px solid var(--border);[m
[32m+[m[32m}[m
[32m+[m[32m.hero-story-proof span {[m
[32m+[m[32m  font-size: 12px;[m
[32m+[m[32m  letter-spacing: .1em;[m
[32m+[m[32m  text-transform: uppercase;[m
[32m+[m[32m  color: var(--cream-35);[m
[32m+[m[32m}[m
[32m+[m[32m.hero-story-proof strong { color: var(--gold-mid); font-weight: 600; }[m
[32m+[m
[32m+[m[32m/* Two-plate collage: a tall portrait with a smaller overlap */[m
[32m+[m[32m.hero-collage { position: relative; }[m
[32m+[m[32m.hero-collage .photo-slot-primary { box-shadow: var(--shadow-lg); }[m
[32m+[m[32m.hero-collage .photo-slot-secondary {[m
[32m+[m[32m  position: absolute;[m
[32m+[m[32m  right: -22px;[m
[32m+[m[32m  bottom: -40px;[m
[32m+[m[32m  width: 46%;[m
[32m+[m[32m  box-shadow: var(--shadow-lg);[m
[32m+[m[32m  border-color: var(--border-gold);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m.hero-story-scripture {[m
[32m+[m[32m  position: relative;[m
[32m+[m[32m  z-index: 2;[m
[32m+[m[32m  margin-top: clamp(48px, 7vw, 76px);[m
[32m+[m[32m  padding-top: 26px;[m
[32m+[m[32m  border-top: 1px solid var(--border-gold);[m
[32m+[m[32m  max-width: 620px;[m
[32m+[m[32m}[m
[32m+[m[32m.hero-story-scripture p {[m
[32m+[m[32m  font-family: var(--font-accent);[m
[32m+[m[32m  font-style: italic;[m
[32m+[m[32m  font-size: clamp(1.05rem, 1.7vw, 1.35rem);[m
[32m+[m[32m  color: var(--cream-60);[m
[32m+[m[32m  line-height: 1.6;[m
[32m+[m[32m}[m
[32m+[m[32m.hero-story-scripture cite {[m
[32m+[m[32m  display: block;[m
[32m+[m[32m  margin-top: 10px;[m
[32m+[m[32m  font-family: var(--font-body);[m
[32m+[m[32m  font-style: normal;[m
[32m+[m[32m  font-size: 11px;[m
[32m+[m[32m  letter-spacing: .2em;[m
[32m+[m[32m  text-transform: uppercase;[m
[32m+[m[32m  color: var(--gold-mid);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m   SCRIPTURE BAND — the elegant separator between acts[m
[32m+[m[32m   ============================================================ */[m
[32m+[m[32m.scripture-band {[m
[32m+[m[32m  position: relative;[m
[32m+[m[32m  padding-block: clamp(72px, 10vw, 128px);[m
[32m+[m[32m  text-align: center;[m
[32m+[m[32m  overflow: hidden;[m
[32m+[m[32m  background: var(--bg);[m
[32m+[m[32m}[m
[32m+[m[32m.scripture-band::before {[m
[32m+[m[32m  content: '';[m
[32m+[m[32m  position: absolute;[m
[32m+[m[32m  inset: 0;[m
[32m+[m[32m  background: radial-gradient(60% 100% at 50% 50%, rgba(212,175,55,.10), transparent 70%);[m
[32m+[m[32m  pointer-events: none;[m
[32m+[m[32m}[m
[32m+[m[32m.scripture-band-burgundy {[m
[32m+[m[32m  background: linear-gradient(160deg, #2A1414 0%, var(--burgundy) 52%, #3A1616 100%);[m
[32m+[m[32m}[m
[32m+[m[32m.scripture-band-ivory {[m
[32m+[m[32m  background: var(--grad-ivory);[m
[32m+[m[32m  border-block: 1px solid var(--ink-border);[m
[32m+[m[32m}[m
[32m+[m[32m.scripture-band-ivory::before {[m
[32m+[m[32m  background: radial-gradient(60% 100% at 50% 50%, rgba(166,124,82,.12), transparent 70%);[m
[32m+[m[32m}[m
[32m+[m[32m.scripture-band .container { position: relative; z-index: 1; }[m
[32m+[m
[32m+[m[32m.scripture-mark {[m
[32m+[m[32m  display: block;[m
[32m+[m[32m  margin-inline: auto;[m
[32m+[m[32m  width: 22px;[m
[32m+[m[32m  height: 30px;[m
[32m+[m[32m  color: var(--gold);[m
[32m+[m[32m  opacity: .8;[m
[32m+[m[32m  margin-bottom: 30px;[m
[32m+[m[32m}[m
[32m+[m[32m.scripture-band-ivory .scripture-mark { color: var(--bronze); }[m
[32m+[m
[32m+[m[32m.scripture-band blockquote {[m
[32m+[m[32m  font-family: var(--font-accent);[m
[32m+[m[32m  font-style: italic;[m
[32m+[m[32m  font-size: clamp(1.5rem, 3.6vw, 2.9rem);[m
[32m+[m[32m  line-height: 1.4;[m
[32m+[m[32m  letter-spacing: .01em;[m
[32m+[m[32m  color: var(--cream);[m
[32m+[m[32m  max-width: 20ch;[m
[32m+[m[32m  margin-inline: auto;[m
[32m+[m[32m  text-wrap: balance;[m
[32m+[m[32m}[m
[32m+[m[32m.scripture-band-ivory blockquote { color: var(--ink); }[m
[32m+[m[32m.scripture-band cite {[m
[32m+[m[32m  display: block;[m
[32m+[m[32m  margin-top: 28px;[m
[32m+[m[32m  font-family: var(--font-body);[m
[32m+[m[32m  font-style: normal;[m
[32m+[m[32m  font-size: 11px;[m
[32m+[m[32m  font-weight: 600;[m
[32m+[m[32m  letter-spacing: .26em;[m
[32m+[m[32m  text-transform: uppercase;[m
[32m+[m[32m  color: var(--gold-mid);[m
[32m+[m[32m}[m
[32m+[m[32m.scripture-band-ivory cite { color: var(--bronze-deep); }[m
[32m+[m[32m.scripture-band-burgundy blockquote { color: #F4E7D8; }[m
[32m+[m[32m.scripture-band-burgundy cite { color: var(--gold-light); }[m
[32m+[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m   STORY CHAPTERS — alternating editorial spreads[m
[32m+[m[32m   ============================================================ */[m
[32m+[m[32m.chapter {[m
[32m+[m[32m  display: grid;[m
[32m+[m[32m  grid-template-columns: 1fr 1fr;[m
[32m+[m[32m  align-items: center;[m
[32m+[m[32m  gap: clamp(36px, 6vw, 96px);[m
[32m+[m[32m}[m
[32m+[m[32m.chapter-reverse .chapter-media { order: 2; }[m
[32m+[m[32m.chapter-reverse .chapter-copy  { order: 1; }[m
[32m+[m
[32m+[m[32m.chapter-copy { max-width: 540px; }[m
[32m+[m[32m.chapter-number {[m
[32m+[m[32m  display: block;[m
[32m+[m[32m  font-family: var(--font-display);[m
[32m+[m[32m  font-size: 12px;[m
[32m+[m[32m  letter-spacing: .32em;[m
[32m+[m[32m  color: var(--gold-mid);[m
[32m+[m[32m  margin-bottom: 20px;[m
[32m+[m[32m}[m
[32m+[m[32m.chapter-copy h2 { margin-top: 14px; }[m
[32m+[m[32m.chapter-copy > p {[m
[32m+[m[32m  margin-top: 22px;[m
[32m+[m[32m  font-size: 1.02rem;[m
[32m+[m[32m  line-height: 1.9;[m
[32m+[m[32m  color: var(--cream-60);[m
[32m+[m[32m}[m
[32m+[m[32m.chapter-copy .btn { margin-top: 32px; }[m
[32m+[m
[32m+[m[32m.chapter-points {[m
[32m+[m[32m  margin-top: 30px;[m
[32m+[m[32m  display: grid;[m
[32m+[m[32m  gap: 16px;[m
[32m+[m[32m}[m
[32m+[m[32m.chapter-point {[m
[32m+[m[32m  display: grid;[m
[32m+[m[32m  grid-template-columns: auto 1fr;[m
[32m+[m[32m  gap: 14px;[m
[32m+[m[32m  align-items: start;[m
[32m+[m[32m}[m
[32m+[m[32m.chapter-point svg {[m
[32m+[m[32m  width: 15px;[m
[32m+[m[32m  height: 20px;[m
[32m+[m[32m  color: var(--gold);[m
[32m+[m[32m  margin-top: 4px;[m
[32m+[m[32m  flex-shrink: 0;[m
[32m+[m[32m}[m
[32m+[m[32m.chapter-point strong {[m
[32m+[m[32m  display: block;[m
[32m+[m[32m  font-family: var(--font-display);[m
[32m+[m[32m  font-size: .96rem;[m
[32m+[m[32m  letter-spacing: .04em;[m
[32m+[m[32m  color: var(--cream);[m
[32m+[m[32m  margin-bottom: 3px;[m
[32m+[m[32m}[m
[32m+[m[32m.chapter-point span { font-size: .92rem; line-height: 1.65; color: var(--cream-60); }[m
[32m+[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m   MANIFESTO — full-bleed statement[m
[32m+[m[32m   ============================================================ */[m
[32m+[m[32m.manifesto {[m
[32m+[m[32m  position: relative;[m
[32m+[m[32m  padding-block: var(--sp-7);[m
[32m+[m[32m  text-align: center;[m
[32m+[m[32m  overflow: hidden;[m
[32m+[m[32m  background: var(--grad-charcoal);[m
[32m+[m[32m}[m
[32m+[m[32m.manifesto::before {[m
[32m+[m[32m  content: '';[m
[32m+[m[32m  position: absolute;[m
[32m+[m[32m  inset: 0;[m
[32m+[m[32m  background:[m
[32m+[m[32m    radial-gradient(50% 60% at 50% 0%, rgba(212,175,55,.12), transparent 65%),[m
[32m+[m[32m    radial-gradient(48% 52% at 50% 100%, rgba(90,30,30,.26), transparent 66%);[m
[32m+[m[32m}[m
[32m+[m[32m.manifesto .container { position: relative; z-index: 1; }[m
[32m+[m[32m.manifesto h2 {[m
[32m+[m[32m  font-size: clamp(2.1rem, 5.2vw, 4rem);[m
[32m+[m[32m  max-width: 16ch;[m
[32m+[m[32m  margin-inline: auto;[m
[32m+[m[32m}[m
[32m+[m[32m.manifesto h2 em {[m
[32m+[m[32m  font-style: italic;[m
[32m+[m[32m  background: var(--grad-gold);[m
[32m+[m[32m  -webkit-background-clip: text;[m
[32m+[m[32m  background-clip: text;[m
[32m+[m[32m  color: transparent;[m
[32m+[m[32m}[m
[32m+[m[32m.manifesto p {[m
[32m+[m[32m  margin: 30px auto 0;[m
[32m+[m[32m  max-width: 58ch;[m
[32m+[m[32m  font-size: 1.05rem;[m
[32m+[m[32m  line-height: 1.95;[m
[32m+[m[32m  color: var(--cream-60);[m
[32m+[m[32m}[m
[32m+[m[32m.manifesto-actions { margin-top: 44px; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }[m
[32m+[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m   PILLARS — "Built for Believers"[m
[32m+[m[32m   ============================================================ */[m
[32m+[m[32m.pillars {[m
[32m+[m[32m  display: grid;[m
[32m+[m[32m  grid-template-columns: repeat(3, 1fr);[m
[32m+[m[32m  gap: clamp(20px, 3vw, 36px);[m
[32m+[m[32m}[m
[32m+[m[32m.pillar {[m
[32m+[m[32m  padding: clamp(28px, 3vw, 40px);[m
[32m+[m[32m  border: 1px solid var(--border);[m
[32m+[m[32m  border-radius: var(--radius-lg);[m
[32m+[m[32m  background: linear-gradient(165deg, var(--surface-1), var(--bg));[m
[32m+[m[32m  transition: border-color .5s var(--ease-editorial), transform .5s var(--ease-editorial), box-shadow .5s var(--ease-editorial);[m
[32m+[m[32m}[m
[32m+[m[32m.surface-ivory .pillar {[m
[32m+[m[32m  background: linear-gradient(165deg, #FFFFFF, #F4F0E9);[m
[32m+[m[32m  box-shadow: var(--shadow-ivory);[m
[32m+[m[32m}[m
[32m+[m[32m.pillar:hover {[m
[32m+[m[32m  border-color: var(--border-gold);[m
[32m+[m[32m  transform: translateY(-5px);[m
[32m+[m[32m  box-shadow: var(--shadow-md);[m
[32m+[m[32m}[m
[32m+[m[32m.pillar-num {[m
[32m+[m[32m  font-family: var(--font-display);[m
[32m+[m[32m  font-size: 11px;[m
[32m+[m[32m  letter-spacing: .3em;[m
[32m+[m[32m  color: var(--gold-mid);[m
[32m+[m[32m}[m
[32m+[m[32m.pillar h3 { margin-top: 18px; }[m
[32m+[m[32m.pillar p { margin-top: 14px; font-size: .95rem; line-height: 1.8; color: var(--cream-60); }[m
[32m+[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m   COMMUNITY — testimonies, gallery, prayer wall[m
[32m+[m[32m   ============================================================ */[m
[32m+[m[32m.testimony-grid {[m
[32m+[m[32m  display: grid;[m
[32m+[m[32m  grid-template-columns: repeat(3, 1fr);[m
[32m+[m[32m  gap: clamp(20px, 3vw, 32px);[m
[32m+[m[32m}[m
[32m+[m[32m.testimony {[m
[32m+[m[32m  display: flex;[m
[32m+[m[32m  flex-direction: column;[m
[32m+[m[32m  padding: clamp(26px, 3vw, 36px);[m
[32m+[m[32m  border: 1px solid var(--border);[m
[32m+[m[32m  border-radius: var(--radius-lg);[m
[32m+[m[32m  background: var(--surface-1);[m
[32m+[m[32m  transition: border-color .5s var(--ease-editorial), transform .5s var(--ease-editorial);[m
[32m+[m[32m}[m
[32m+[m[32m.surface-ivory .testimony { background: #FFFFFF; box-shadow: var(--shadow-ivory); }[m
[32m+[m[32m.testimony:hover { border-color: var(--border-gold); transform: translateY(-4px); }[m
[32m+[m[32m.testimony-mark {[m
[32m+[m[32m  font-family: var(--font-accent);[m
[32m+[m[32m  font-size: 2.6rem;[m
[32m+[m[32m  line-height: 1;[m
[32m+[m[32m  color: var(--gold);[m
[32m+[m[32m  opacity: .5;[m
[32m+[m[32m}[m
[32m+[m[32m.testimony blockquote {[m
[32m+[m[32m  margin-top: 12px;[m
[32m+[m[32m  flex: 1;[m
[32m+[m[32m  font-family: var(--font-accent);[m
[32m+[m[32m  font-style: italic;[m
[32m+[m[32m  font-size: 1.12rem;[m
[32m+[m[32m  line-height: 1.68;[m
[32m+[m[32m  color: var(--cream);[m
[32m+[m[32m}[m
[32m+[m[32m.testimony-author {[m
[32m+[m[32m  display: flex;[m
[32m+[m[32m  align-items: center;[m
[32m+[m[32m  gap: 12px;[m
[32m+[m[32m  margin-top: 26px;[m
[32m+[m[32m  padding-top: 20px;[m
[32m+[m[32m  border-top: 1px solid var(--border);[m
[32m+[m[32m}[m
[32m+[m[32m.testimony-avatar {[m
[32m+[m[32m  width: 38px;[m
[32m+[m[32m  height: 38px;[m
[32m+[m[32m  border-radius: 50%;[m
[32m+[m[32m  background: linear-gradient(140deg, var(--bronze), var(--gold-deep));[m
[32m+[m[32m  display: grid;[m
[32m+[m[32m  place-items: center;[m
[32m+[m[32m  font-family: var(--font-display);[m
[32m+[m[32m  font-size: .8rem;[m
[32m+[m[32m  color: #1A1410;[m
[32m+[m[32m  flex-shrink: 0;[m
[32m+[m[32m}[m
[32m+[m[32m.testimony-author cite {[m
[32m+[m[32m  font-style: normal;[m
[32m+[m[32m  font-family: var(--font-body);[m
[32m+[m[32m  font-size: .88rem;[m
[32m+[m[32m  font-weight: 600;[m
[32m+[m[32m  color: var(--cream);[m
[32m+[m[32m  display: block;[m
[32m+[m[32m}[m
[32m+[m[32m.testimony-author small {[m
[32m+[m[32m  display: block;[m
[32m+[m[32m  font-size: .76rem;[m
[32m+[m[32m  letter-spacing: .08em;[m
[32m+[m[32m  text-transform: uppercase;[m
[32m+[m[32m  color: var(--cream-35);[m
[32m+[m[32m  margin-top: 2px;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* Customer gallery — a mosaic of community photo slots */[m
[32m+[m[32m.gallery-mosaic {[m
[32m+[m[32m  display: grid;[m
[32m+[m[32m  grid-template-columns: repeat(4, 1fr);[m
[32m+[m[32m  gap: clamp(10px, 1.4vw, 18px);[m
[32m+[m[32m}[m
[32m+[m[32m.gallery-mosaic .photo-slot { aspect-ratio: 1 / 1; border-radius: var(--radius); }[m
[32m+[m[32m.gallery-mosaic .gallery-feature { grid-row: span 2; grid-column: span 2; aspect-ratio: 1 / 1; }[m
[32m+[m
[32m+[m[32m.gallery-cta {[m
[32m+[m[32m  margin-top: 36px;[m
[32m+[m[32m  text-align: center;[m
[32m+[m[32m}[m
[32m+[m[32m.gallery-tag {[m
[32m+[m[32m  display: inline-flex;[m
[32m+[m[32m  align-items: center;[m
[32m+[m[32m  gap: 10px;[m
[32m+[m[32m  padding: 10px 20px;[m
[32m+[m[32m  border: 1px solid var(--border-gold);[m
[32m+[m[32m  border-radius: 999px;[m
[32m+[m[32m  font-family: var(--font-display);[m
[32m+[m[32m  font-size: .9rem;[m
[32m+[m[32m  letter-spacing: .1em;[m
[32m+[m[32m  color: var(--gold-mid);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/* Prayer wall */[m
[32m+[m[32m.prayer-wall {[m
[32m+[m[32m  display: grid;[m
[32m+[m[32m  grid-template-columns: .92fr 1.08fr;[m
[32m+[m[32m  gap: clamp(32px, 5vw, 72px);[m
[32m+[m[32m  align-items: start;[m
[32m+[m[32m}[m
[32m+[m[32m.prayer-copy h2 { margin-top: 14px; }[m
[32m+[m[32m.prayer-copy > p { margin-top: 22px; color: var(--cream-60); line-height: 1.9; }[m
[32m+[m[32m.prayer-promise {[m
[32m+[m[32m  margin-top: 28px;[m
[32m+[m[32m  padding: 22px 26px;[m
[32m+[m[32m  border-left: 2px solid var(--gold);[m
[32m+[m[32m  background: var(--surface-1);[m
[32m+[m[32m  border-radius: 0 var(--radius) var(--radius) 0;[m
[32m+[m[32m}[m
[32m+[m[32m.surface-ivory .prayer-promise { background: rgba(255,255,255,.72); }[m
[32m+[m[32m.prayer-promise p {[m
[32m+[m[32m  font-family: var(--font-accent);[m
[32m+[m[32m  font-style: italic;[m
[32m+[m[32m  font-size: 1.08rem;[m
[32m+[m[32m  line-height: 1.6;[m
[32m+[m[32m  color: var(--cream);[m
[32m+[m[32m}[m
[32m+[m[32m.prayer-promise cite {[m
[32m+[m[32m  display: block;[m
[32m+[m[32m  margin-top: 10px;[m
[32m+[m[32m  font-family: var(--font-body);[m
[32m+[m[32m  font-style: normal;[m
[32m+[m[32m  font-size: 10px;[m
[32m+[m[32m  letter-spacing: .22em;[m
[32m+[m[32m  text-transform: uppercase;[m
[32m+[m[32m  color: var(--gold-mid);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m.prayer-form {[m
[32m+[m[32m  padding: clamp(28px, 3.4vw, 44px);[m
[32m+[m[32m  border: 1px solid var(--border);[m
[32m+[m[32m  border-radius: var(--radius-lg);[m
[32m+[m[32m  background: linear-gradient(165deg, var(--surface-1), var(--bg));[m
[32m+[m[32m}[m
[32m+[m[32m.surface-ivory .prayer-form {[m
[32m+[m[32m  background: #FFFFFF;[m
[32m+[m[32m  box-shadow: var(--shadow-ivory);[m
[32m+[m[32m}[m
[32m+[m[32m.prayer-form .form-group { margin-bottom: 18px; }[m
[32m+[m[32m.prayer-form .form-row {[m
[32m+[m[32m  display: grid;[m
[32m+[m[32m  grid-template-columns: 1fr 1fr;[m
[32m+[m[32m  gap: 18px;[m
[32m+[m[32m}[m
[32m+[m[32m.prayer-consent {[m
[32m+[m[32m  display: grid;[m
[32m+[m[32m  grid-template-columns: auto 1fr;[m
[32m+[m[32m  gap: 12px;[m
[32m+[m[32m  align-items: start;[m
[32m+[m[32m  margin-block: 6px 22px;[m
[32m+[m[32m}[m
[32m+[m[32m.prayer-consent input[type="checkbox"] {[m
[32m+[m[32m  width: 17px;[m
[32m+[m[32m  height: 17px;[m
[32m+[m[32m  margin-top: 3px;[m
[32m+[m[32m  accent-color: var(--gold);[m
[32m+[m[32m  flex-shrink: 0;[m
[32m+[m[32m}[m
[32m+[m[32m.prayer-consent label { font-size: .86rem; line-height: 1.6; color: var(--cream-60); }[m
[32m+[m[32m.prayer-submit { width: 100%; justify-content: center; }[m
[32m+[m[32m.prayer-note {[m
[32m+[m[32m  margin-top: 16px;[m
[32m+[m[32m  font-size: .78rem;[m
[32m+[m[32m  line-height: 1.6;[m
[32m+[m[32m  color: var(--cream-35);[m
[32m+[m[32m  text-align: center;[m
[32m+[m[32m}[m
[32m+[m[32m.form-status {[m
[32m+[m[32m  margin-top: 16px;[m
[32m+[m[32m  padding: 14px 18px;[m
[32m+[m[32m  border-radius: var(--radius-sm);[m
[32m+[m[32m  font-size: .9rem;[m
[32m+[m[32m  line-height: 1.6;[m
[32m+[m[32m  display: none;[m
[32m+[m[32m}[m
[32m+[m[32m.form-status.is-visible { display: block; }[m
[32m+[m[32m.form-status.is-success {[m
[32m+[m[32m  background: rgba(212,175,55,.10);[m
[32m+[m[32m  border: 1px solid var(--border-gold);[m
[32m+[m[32m  color: var(--gold-mid);[m
[32m+[m[32m}[m
[32m+[m[32m.form-status.is-error {[m
[32m+[m[32m  background: rgba(122,44,44,.14);[m
[32m+[m[32m  border: 1px solid rgba(122,44,44,.4);[m
[32m+[m[32m  color: #E8A0A0;[m
[32m+[m[32m}[m
[32m+[m[32m.surface-ivory .form-status.is-error { color: var(--burgundy); }[m
[32m+[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m   PRODUCT STORY — the message behind each design[m
[32m+[m[32m   ============================================================ */[m
[32m+[m[32m.story-grid {[m
[32m+[m[32m  display: grid;[m
[32m+[m[32m  grid-template-columns: repeat(2, 1fr);[m
[32m+[m[32m  gap: clamp(24px, 3vw, 44px);[m
[32m+[m[32m}[m
[32m+[m[32m.story-card {[m
[32m+[m[32m  display: grid;[m
[32m+[m[32m  grid-template-columns: 200px 1fr;[m
[32m+[m[32m  gap: clamp(20px, 2.5vw, 32px);[m
[32m+[m[32m  padding: clamp(22px, 2.6vw, 32px);[m
[32m+[m[32m  border: 1px solid var(--border);[m
[32m+[m[32m  border-radius: var(--radius-lg);[m
[32m+[m[32m  background: var(--surface-1);[m
[32m+[m[32m  transition: border-color .5s var(--ease-editorial), transform .5s var(--ease-editorial), box-shadow .5s var(--ease-editorial);[m
[32m+[m[32m}[m
[32m+[m[32m.surface-ivory .story-card { background: #FFFFFF; box-shadow: var(--shadow-ivory); }[m
[32m+[m[32m.story-card:hover {[m
[32m+[m[32m  border-color: var(--border-gold);[m
[32m+[m[32m  transform: translateY(-4px);[m
[32m+[m[32m  box-shadow: var(--shadow-md);[m
[32m+[m[32m}[m
[32m+[m[32m.story-card-art {[m
[32m+[m[32m  border-radius: var(--radius);[m
[32m+[m[32m  overflow: hidden;[m
[32m+[m[32m  background: var(--surface-2);[m
[32m+[m[32m  aspect-ratio: 1 / 1;[m
[32m+[m[32m}[m
[32m+[m[32m.surface-ivory .story-card-art { background: #F1EDE6; }[m
[32m+[m[32m.story-card-art img { width: 100%; height: 100%; object-fit: contain; padding: 10px; }[m
[32m+[m
[32m+[m[32m.story-card h3 { color: var(--cream); }[m
[32m+[m[32m.story-card-message {[m
[32m+[m[32m  margin-top: 12px;[m
[32m+[m[32m  font-family: var(--font-accent);[m
[32m+[m[32m  font-style: italic;[m
[32m+[m[32m  font-size: 1.06rem;[m
[32m+[m[32m  line-height: 1.6;[m
[32m+[m[32m  color: var(--gold-mid);[m
[32m+[m[32m}[m
[32m+[m[32m.story-card dl { margin-top: 18px; display: grid; gap: 12px; }[m
[32m+[m[32m.story-card dt {[m
[32m+[m[32m  font-family: var(--font-body);[m
[32m+[m[32m  font-size: 10px;[m
[32m+[m[32m  font-weight: 600;[m
[32m+[m[32m  letter-spacing: .2em;[m
[32m+[m[32m  text-transform: uppercase;[m
[32m+[m[32m  color: var(--cream-35);[m
[32m+[m[32m  margin-bottom: 3px;[m
[32m+[m[32m}[m
[32m+[m[32m.story-card dd { font-size: .92rem; line-height: 1.75; color: var(--cream-60); }[m
[32m+[m[32m.story-card-links {[m
[32m+[m[32m  margin-top: 20px;[m
[32m+[m[32m  padding-top: 16px;[m
[32m+[m[32m  border-top: 1px solid var(--border);[m
[32m+[m[32m  display: flex;[m
[32m+[m[32m  flex-wrap: wrap;[m
[32m+[m[32m  gap: 8px 18px;[m
[32m+[m[32m  align-items: center;[m
[32m+[m[32m}[m
[32m+[m[32m.story-card-links .eyebrow { font-size: 10px; }[m
[32m+[m[32m.story-card-links a {[m
[32m+[m[32m  font-size: .86rem;[m
[32m+[m[32m  color: var(--gold-mid);[m
[32m+[m[32m  border-bottom: 1px solid transparent;[m
[32m+[m[32m  transition: border-color .3s var(--ease);[m
[32m+[m[32m}[m
[32m+[m[32m.story-card-links a:hover { border-bottom-color: currentColor; }[m
[32m+[m
[32m+[m[32m/* Shared fit & care panel */[m
[32m+[m[32m.care-panel {[m
[32m+[m[32m  display: grid;[m
[32m+[m[32m  grid-template-columns: repeat(4, 1fr);[m
[32m+[m[32m  gap: clamp(18px, 2.4vw, 32px);[m
[32m+[m[32m  padding: clamp(28px, 3vw, 40px);[m
[32m+[m[32m  border: 1px solid var(--border-gold);[m
[32m+[m[32m  border-radius: var(--radius-lg);[m
[32m+[m[32m  background: linear-gradient(150deg, var(--surface-1), var(--bg));[m
[32m+[m[32m}[m
[32m+[m[32m.surface-ivory .care-panel { background: linear-gradient(150deg, #FFFFFF, #F4F0E9); }[m
[32m+[m[32m.care-item svg { width: 22px; height: 22px; color: var(--gold); margin-bottom: 14px; }[m
[32m+[m[32m.care-item h4 {[m
[32m+[m[32m  font-family: var(--font-display);[m
[32m+[m[32m  font-size: .95rem;[m
[32m+[m[32m  letter-spacing: .05em;[m
[32m+[m[32m  color: var(--cream);[m
[32m+[m[32m  margin-bottom: 8px;[m
[32m+[m[32m}[m
[32m+[m[32m.care-item p { font-size: .88rem; line-height: 1.75; color: var(--cream-60); }[m
[32m+[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m   MOVEMENT CTA — the last emotional beat before the ask[m
[32m+[m[32m   ============================================================ */[m
[32m+[m[32m.movement-cta {[m
[32m+[m[32m  position: relative;[m
[32m+[m[32m  padding-block: var(--sp-7);[m
[32m+[m[32m  overflow: hidden;[m
[32m+[m[32m  background: linear-gradient(155deg, #1A0F0F 0%, var(--burgundy) 54%, #2C1414 100%);[m
[32m+[m[32m  text-align: center;[m
[32m+[m[32m}[m
[32m+[m[32m.movement-cta::before {[m
[32m+[m[32m  content: '';[m
[32m+[m[32m  position: absolute;[m
[32m+[m[32m  inset: 0;[m
[32m+[m[32m  background: radial-gradient(58% 62% at 50% 42%, rgba(212,175,55,.20), transparent 68%);[m
[32m+[m[32m}[m
[32m+[m[32m.movement-cta .container { position: relative; z-index: 1; }[m
[32m+[m[32m.movement-cta .eyebrow { color: var(--gold-light); }[m
[32m+[m[32m.movement-cta h2 { color: #FBF3E6; max-width: 18ch; margin-inline: auto; }[m
[32m+[m[32m.movement-cta h2 em {[m
[32m+[m[32m  font-style: italic;[m
[32m+[m[32m  background: var(--grad-gold);[m
[32m+[m[32m  -webkit-background-clip: text;[m
[32m+[m[32m  background-clip: text;[m
[32m+[m[32m  color: transparent;[m
[32m+[m[32m}[m
[32m+[m[32m.movement-cta > .container > p {[m
[32m+[m[32m  margin: 26px auto 0;[m
[32m+[m[32m  max-width: 54ch;[m
[32m+[m[32m  color: rgba(251,243,230,.72);[m
[32m+[m[32m  line-height: 1.9;[m
[32m+[m[32m}[m
[32m+[m[32m.movement-cta .btn-primary { background: var(--grad-gold); color: #1A1410; border-color: transparent; }[m
[32m+[m[32m.movement-cta .btn-primary:hover { filter: brightness(1.08); }[m
[32m+[m[32m.movement-cta .btn-outline { border-color: rgba(251,243,230,.35); color: #FBF3E6; }[m
[32m+[m[32m.movement-cta .btn-outline:hover { border-color: var(--gold-light); background: rgba(212,175,55,.10); }[m
[32m+[m[32m.movement-cta-actions { margin-top: 42px; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }[m
[32m+[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m   REFINEMENTS TO EXISTING v4 COMPONENTS[m
[32m+[m[32m   ============================================================ */[m
[32m+[m[32m.product-card {[m
[32m+[m[32m  transition: transform .5s var(--ease-editorial), border-color .5s var(--ease-editorial), box-shadow .5s var(--ease-editorial);[m
[32m+[m[32m}[m
[32m+[m[32m.product-card:hover { box-shadow: var(--shadow-md); }[m
[32m+[m[32m.surface-ivory .product-card { background: #FFFFFF; box-shadow: var(--shadow-ivory); }[m
[32m+[m
[32m+[m[32m.btn { transition: background .4s var(--ease-editorial), color .4s var(--ease-editorial), border-color .4s var(--ease-editorial), transform .4s var(--ease-editorial); }[m
[32m+[m[32m.btn:hover .btn-arrow { transform: translateX(4px); }[m
[32m+[m[32m.btn-arrow { transition: transform .4s var(--ease-editorial); }[m
[32m+[m
[32m+[m[32m.trust-strip { background: var(--surface-1); }[m
[32m+[m[32m.value-card { transition: border-color .5s var(--ease-editorial), transform .5s var(--ease-editorial), box-shadow .5s var(--ease-editorial); }[m
[32m+[m
[32m+[m[32m/* Section intro copy used under headings across pages */[m
[32m+[m[32m.section-lede {[m
[32m+[m[32m  max-width: 60ch;[m
[32m+[m[32m  margin: 20px auto 0;[m
[32m+[m[32m  font-size: 1.02rem;[m
[32m+[m[32m  line-height: 1.9;[m
[32m+[m[32m  color: var(--cream-60);[m
[32m+[m[32m}[m
[32m+[m[32m.section-header.is-left { text-align: left; }[m
[32m+[m[32m.section-header.is-left .section-lede { margin-inline: 0; }[m
[32m+[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m   2.0 RESPONSIVE[m
[32m+[m[32m   ============================================================ */[m
[32m+[m[32m@media (max-width: 1024px) {[m
[32m+[m[32m  .story-grid { grid-template-columns: 1fr; }[m
[32m+[m[32m  .care-panel { grid-template-columns: repeat(2, 1fr); }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m@media (max-width: 900px) {[m
[32m+[m[32m  .hero-story-inner { grid-template-columns: 1fr; gap: 48px; }[m
[32m+[m[32m  .hero-collage { max-width: 460px; margin-inline: auto; width: 100%; }[m
[32m+[m[32m  .hero-collage .photo-slot-secondary { right: -12px; bottom: -24px; width: 42%; }[m
[32m+[m
[32m+[m[32m  .chapter { grid-template-columns: 1fr; gap: 36px; }[m
[32m+[m[32m  .chapter-reverse .chapter-media { order: 0; }[m
[32m+[m[32m  .chapter-reverse .chapter-copy  { order: 0; }[m
[32m+[m[32m  .chapter-copy { max-width: none; }[m
[32m+[m
[32m+[m[32m  .pillars { grid-template-columns: 1fr; }[m
[32m+[m[32m  .testimony-grid { grid-template-columns: 1fr; }[m
[32m+[m[32m  .prayer-wall { grid-template-columns: 1fr; }[m
[32m+[m[32m  .gallery-mosaic { grid-template-columns: repeat(2, 1fr); }[m
[32m+[m[32m  .gallery-mosaic .gallery-feature { grid-row: span 1; grid-column: span 2; aspect-ratio: 3 / 2; }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m@media (max-width: 640px) {[m
[32m+[m[32m  .story-card { grid-template-columns: 1fr; }[m
[32m+[m[32m  .story-card-art { max-width: 220px; }[m
[32m+[m[32m  .care-panel { grid-template-columns: 1fr; }[m
[32m+[m[32m  .prayer-form .form-row { grid-template-columns: 1fr; }[m
[32m+[m[32m  .hero-story { min-height: auto; padding-bottom: 56px; }[m
[32m+[m[32m  .hero-story-actions .btn { width: 100%; justify-content: center; }[m
[32m+[m[32m  .movement-cta-actions .btn,[m
[32m+[m[32m  .manifesto-actions .btn { width: 100%; justify-content: center; }[m
[32m+[m[32m  .scripture-band blockquote { max-width: 16ch; }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m
[32m+[m[32m/* ============================================================[m
[32m+[m[32m   2.0 REDUCED MOTION[m
[32m+[m[32m   Repeated here so the new primitives are covered even though[m
[32m+[m[32m   the v4 block above already handles .reveal and the marquee.[m
[32m+[m[32m   ============================================================ */[m
[32m+[m[32m@media (prefers-reduced-motion: reduce) {[m
[32m+[m[32m  .reveal-left, .reveal-right, .reveal-scale,[m
[32m+[m[32m  .stagger > * {[m
[32m+[m[32m    opacity: 1 !important;[m
[32m+[m[32m    transform: none !important;[m
[32m+[m[32m    transition: none !important;[m
[32m+[m[32m  }[m
[32m+[m[32m  .rise-words .word > span { transform: none !important; transition: none !important; }[m
[32m+[m[32m  .parallax { transform: none !important; }[m
[32m+[m[32m  .lift:hover { transform: none !important; }[m
[32m+[m[32m  .photo-slot:hover img { transform: none !important; }[m
[32m+[m[32m}[m
