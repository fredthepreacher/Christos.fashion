[32m+[m[32m          </article>[m
[32m+[m
[32m+[m[32m          <article class="story-card reveal">[m
[32m+[m[32m            <div class="story-card-art">[m
[32m+[m[32m              <img src="assets/designs/god-taught-me.png" alt="God Taught Me design artwork" loading="lazy" decoding="async" width="600" height="600" />[m
[32m+[m[32m            </div>[m
[32m+[m[32m            <div>[m
[32m+[m[32m              <h3>God Taught Me</h3>[m
[32m+[m[32m              <p class="story-card-message">"The lesson cost something. I'd still take it."</p>[m
[32m+[m[32m              <dl>[m
[32m+[m[32m                <dt>Why it matters</dt>[m
