[32m+[m[32m// ============================================================[m
[32m+[m[32m// WORD RISE — wrap headline words so each can rise on cue[m
[32m+[m[32m// ============================================================[m
[32m+[m[32mdocument.querySelectorAll('.rise-words').forEach(el => {[m
[32m+[m[32m  if (el.dataset.riseReady) return;[m
[32m+[m[32m  el.innerHTML = el.textContent[m
[32m+[m[32m    .trim()[m
[32m+[m[32m    .split(/\s+/)[m
