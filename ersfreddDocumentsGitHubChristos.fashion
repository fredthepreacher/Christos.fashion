[32m+[m[32m// ============================================================[m
[32m+[m[32m// PRAYER REQUEST FORM — Netlify Forms (AJAX + inline status)[m
[32m+[m[32m// Same pattern as the newsletter: posts to the Netlify form[m
[32m+[m[32m// named "prayer-request", with a honeypot and a no-JS fallback[m
[32m+[m[32m// to a native POST. Nothing is ever shown publicly.[m
[32m+[m[32m// ============================================================[m
[32m+[m[32mdocument.querySelectorAll('.prayer-form').forEach(form => {[m
[32m+[m[32m  const status = form.querySelector('.form-status');[m
[32m+[m
[32m+[m[32m  form.addEventListener('submit', async e => {[m
[32m+[m[32m    e.preventDefault();[m
[32m+[m[32m    const btn = form.querySelector('button[type="submit"]');[m
[32m+[m[32m    const originalText = btn.textContent;[m
[32m+[m
[32m+[m[32m    btn.disabled = true;[m
[32m+[m[32m    btn.textContent = 'Sending…';[m
[32m+[m[32m    if (status) status.classList.remove('is-visible', 'is-success', 'is-error');[m
[32m+[m
[32m+[m[32m    try {[m
[32m+[m[32m      const res = await fetch('/', {[m
[32m+[m[32m        method: 'POST',[m
[32m+[m[32m        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },[m
[32m+[m[32m        body: new URLSearchParams(new FormData(form)).toString(),[m
[32m+[m[32m      });[m
[32m+[m[32m      if (!res.ok) throw new Error('HTTP ' + res.status);[m
[32m+[m
[32m+[m[32m      form.reset();[m
[32m+[m[32m      if (status) {[m
[32m+[m[32m        status.textContent =[m
[32m+[m[32m          'Received. Our team is praying over this today — you are not carrying it alone.';[m
[32m+[m[32m        status.classList.add('is-visible', 'is-success');[m
[32m+[m[32m      }[m
[32m+[m[32m      btn.textContent = '✓ Sent';[m
[32m+[m[32m    } catch (err) {[m
[32m+[m[32m      console.error('Prayer request failed:', err);[m
[32m+[m[32m      if (status) {[m
[32m+[m[32m        status.textContent =[m
[32m+[m[32m          "That didn't send. Please try again, or email hello@christos.fashion and we'll pray with you.";[m
[32m+[m[32m        status.classList.add('is-visible', 'is-error');[m
[32m+[m[32m      }[m
[32m+[m[32m      btn.textContent = 'Try again';[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    setTimeout(() => {[m
[32m+[m[32m      btn.textContent = originalText;[m
[32m+[m[32m      btn.disabled = false;[m
