[32m+[m[32m    <!-- ============================================================[m
[32m+[m[32m         COMMUNITY — testimonies[m
[32m+[m[32m         ============================================================ -->[m
[32m+[m[32m    <section class="section section-editorial" id="community" aria-labelledby="community-heading">[m
[32m+[m[32m      <div class="container">[m
[32m+[m[32m        <div class="section-header reveal" style="text-align:center">[m
[32m+[m[32m          <p class="eyebrow">Represent the Kingdom</p>[m
[32m+[m[32m          <h2 id="community-heading">You're Not the Only One<br><span class="title-italic">Wearing It.</span></h2>[m
[32m+[m[32m          <p class="section-lede">[m
[32m+[m[32m            Believers across the country are putting these on and finding out what happens next.[m
[32m+[m[32m            These are a few of the conversations that followed.[m
[32m+[m[32m          </p>[m
[32m+[m[32m        </div>[m
[32m+[m
[32m+[m[32m        <div class="testimony-grid stagger">[m
[32m+[m[32m          <figure class="testimony">[m
[32m+[m[32m            <span class="testimony-mark" aria-hidden="true">"</span>[m
[32m+[m[32m            <blockquote>[m
[32m+[m[32m              A woman at the gym stopped me and said her son had walked away from church.[m
[32m+[m[32m              We prayed right there by the treadmills. I've never had that happen over a T-shirt before.[m
[32m+[m[32m            </blockquote>[m
[32m+[m[32m            <figcaption class="testimony-author">[m
[32m+[m[32m              <span class="testimony-avatar" aria-hidden="true">M</span>[m
[32m+[m[32m              <span>[m
[32m+[m[32m                <cite>Marcus T.</cite>[m
[32m+[m[32m                <small>Wearing Faith Over Fear</small>[m
[32m+[m[32m              </span>[m
[32m+[m[32m            </figcaption>[m
[32m+[m[32m          </figure>[m
[32m+[m
[32m+[m[32m          <figure class="testimony">[m
[32m+[m[32m            <span class="testimony-mark" aria-hidden="true">"</span>[m
[32m+[m[32m            <blockquote>[m
[32m+[m[32m              I bought <em>I Thought It Was Over</em> two weeks after losing my job. Wore it to[m
[32m+[m[32m              the interview I almost didn't go to. I start Monday.[m
[32m+[m[32m            </blockquote>[m
[32m+[m[32m            <figcaption class="testimony-author">[m
[32m+[m[32m              <span class="testimony-avatar" aria-hidden="true">D</span>[m
[32m+[m[32m              <span>[m
[32m+[m[32m                <cite>Danielle R.</cite>[m
[32m+[m[32m                <small>Wearing I Thought It Was Over</small>[m
[32m+[m[32m              </span>[m
[32m+[m[32m            </figcaption>[m
[32m+[m[32m          </figure>[m
[32m+[m
[32m+[m[32m          <figure class="testimony">[m
[32m+[m[32m            <span class="testimony-mark" aria-hidden="true">"</span>[m
[32m+[m[32m            <blockquote>[m
[32m+[m[32m              My teenage son asked for the trucker hat. He wears it every single day. If two[m
[32m+[m[32m              words on a cap keep his faith in front of him, that's worth more than I paid.[m
[32m+[m[32m            </blockquote>[m
[32m+[m[32m            <figcaption class="testimony-author">[m
[32m+[m[32m              <span class="testimony-avatar" aria-hidden="true">J</span>[m
[32m+[m[32m              <span>[m
[32m+[m[32m                <cite>James O.</cite>[m
[32m+[m[32m                <small>Wearing Jesus Saves</small>[m
[32m+[m[32m              </span>[m
[32m+[m[32m            </figcaption>[m
[32m+[m[32m          </figure>[m
[32m+[m[32m        </div>[m
[32m+[m[32m      </div>[m
