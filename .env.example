# Secret server-side values — configure in Netlify, never commit real values.
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public measurement IDs — configure in Netlify when accounts are ready.
GA4_MEASUREMENT_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_PURCHASE_LABEL=

# Meta / Facebook advertising. Leave blank to keep the integration completely
# inert — no Pixel script is requested and no server events are sent.
META_PIXEL_ID=
# SERVER-SIDE ONLY. Never add this to netlify/functions/public-config.js.
META_CAPI_TOKEN=
# Optional: set while validating in Events Manager -> Test Events, then REMOVE
# it, or live conversions keep being classified as test traffic.
META_TEST_EVENT_CODE=
# Optional Graph API version override (default v25.0).
META_GRAPH_VERSION=
